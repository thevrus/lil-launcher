<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/photo"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:foreground="@drawable/photo_scrim" android:importantForAccessibility="no"/>

    <!-- The top padding is set in code to sit just under the header, whatever the font scale. -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingStart="@dimen/grid_pad_h" android:paddingEnd="@dimen/grid_pad_h" android:paddingBottom="@dimen/overscan_v"
        android:clipToPadding="false" android:clipChildren="false"/>

    <!-- Scrolls with the grid: translated by the grid's offset in code. -->
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/overscan_h" android:paddingEnd="@dimen/overscan_h" android:paddingTop="@dimen/overscan_v">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/chip"
                android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_spark" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/deviceName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:maxLines="1" android:ellipsize="end"
                    android:textSize="15sp" android:letterSpacing="-0.01" android:textColor="@color/ink"
                    android:fontFamily="@font/inter_semibold" android:shadowColor="@color/text_shadow" android:shadowRadius="6"/>
            <!-- TVs with HDMI ports only; hidden on boxes like the Shield. -->
            <ImageView android:id="@+id/inputBtn" style="@style/Chip"
                    android:src="@drawable/ic_input" android:contentDescription="@string/inputs" android:visibility="gone"/>
            <FrameLayout android:layout_width="@dimen/chip" android:layout_height="@dimen/chip" android:layout_marginStart="@dimen/chip_gap">
                <ImageView android:id="@+id/netBtn" style="@style/Chip" android:layout_marginStart="0dp"
                    android:src="@drawable/ic_globe" android:contentDescription="@string/network"/>
                <View android:id="@+id/vpnDot" android:layout_width="7dp" android:layout_height="7dp"
                    android:layout_gravity="top|end" android:layout_marginTop="7dp" android:layout_marginEnd="7dp"
                    android:background="@drawable/vpn_dot" android:visibility="gone"/>
            </FrameLayout>
            <ImageView android:id="@+id/settingsBtn" style="@style/Chip"
                    android:src="@drawable/ic_gear" android:contentDescription="@string/settings"/>
            <!-- Plain text, not a chip: it does nothing when focused, so it must not look like a button. -->
            <TextView android:id="@+id/city" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="26dp" android:maxLines="1" android:visibility="gone"
                    android:textSize="15sp" android:letterSpacing="-0.01" android:textColor="@color/ink" android:fontFamily="@font/inter_medium"
                    android:shadowColor="@color/text_shadow" android:shadowRadius="6"/>
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp"
                    android:format12Hour="@string/time_12" android:format24Hour="@string/time_24"
                    android:textSize="15sp" android:letterSpacing="-0.01" android:textColor="@color/ink"
                    android:fontFamily="@font/inter_medium" android:shadowColor="@color/text_shadow" android:shadowRadius="6"/>
        </LinearLayout>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp"
                android:format12Hour="@string/date_long" android:format24Hour="@string/date_long" android:textAllCaps="true"
                android:textSize="11sp" android:letterSpacing="0.18" android:textColor="@color/ink_dim"
                android:fontFamily="@font/inter_medium" android:shadowColor="@color/text_shadow" android:shadowRadius="6"/>
        <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:includeFontPadding="false" android:maxLines="1"
                android:textSize="44sp" android:letterSpacing="-0.035" android:textColor="@color/ink"
                android:fontFamily="@font/inter_semibold" android:shadowColor="@color/text_shadow" android:shadowDy="1" android:shadowRadius="12"/>
        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:maxLines="1"
                android:textSize="14sp" android:letterSpacing="-0.01" android:textColor="@color/ink"
                android:fontFamily="@font/inter_medium" android:shadowColor="@color/text_shadow" android:shadowRadius="8"/>
        <!-- Weather and the next sunrise or sunset; empty until the first fetch. -->
        <TextView android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:maxLines="1"
                android:textSize="12sp" android:letterSpacing="-0.005" android:textColor="@color/ink_dim"
                android:fontFamily="@font/inter_medium" android:shadowColor="@color/text_shadow" android:shadowRadius="6"/>

    </LinearLayout>

    <TextView android:id="@+id/caption" style="@style/Text.Small"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_marginStart="@dimen/overscan_h" android:layout_marginBottom="22dp"
        android:maxLines="1" android:ellipsize="end" android:alpha="0"
        android:shadowColor="@color/text_shadow" android:shadowDy="1" android:shadowRadius="6"/>
    <!-- Centered under the globe in code. -->
    <LinearLayout android:id="@+id/popover"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_marginTop="84dp"
        android:orientation="vertical" android:background="@drawable/popover_bg"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="11dp"
        android:visibility="gone" android:alpha="0">
        <TextView android:id="@+id/popNet" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink"/>
        <TextView android:id="@+id/popVpn" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/popRate" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
    </LinearLayout>
</FrameLayout>
