<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/photo"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:foreground="@drawable/photo_scrim" android:importantForAccessibility="no"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingStart="45dp" android:paddingEnd="45dp" android:paddingTop="84dp" android:paddingBottom="40dp"
        android:clipToPadding="false" android:clipChildren="false"/>
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="@dimen/overscan_h" android:paddingEnd="@dimen/overscan_h" android:paddingTop="@dimen/overscan_v">
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm" android:format24Hour="HH:mm"
                android:textSize="26sp" android:letterSpacing="-0.03" android:textColor="@color/ink"
                android:fontFamily="@font/inter_semibold" android:includeFontPadding="false"
                android:shadowColor="@color/text_shadow" android:shadowDy="1" android:shadowRadius="4"/>
        <TextClock style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="a" android:format24Hour="" android:layout_marginStart="3dp" android:textSize="12sp"/>
        <TextClock style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="@string/date_format" android:format24Hour="@string/date_format" android:layout_marginStart="11dp"/>
        <TextView android:id="@+id/weather" style="@style/Text.Small" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1"/>
        <!-- TVs with HDMI ports only; hidden on boxes like the Shield. -->
        <ImageView android:id="@+id/inputBtn"
                android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:layout_marginEnd="10dp"
                android:src="@drawable/ic_input" android:background="@drawable/gear_bg" android:tint="@color/gear_tint"
                android:focusable="true" android:focusableInTouchMode="true" android:contentDescription="@string/inputs"
                android:visibility="gone"/>
        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp">
            <ImageView android:id="@+id/netBtn"
                android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:src="@drawable/ic_globe" android:background="@drawable/gear_bg" android:tint="@color/gear_tint"
                android:focusable="true" android:focusableInTouchMode="true" android:contentDescription="@string/network"/>
            <View android:id="@+id/vpnDot" android:layout_width="7dp" android:layout_height="7dp"
                android:layout_gravity="top|end" android:layout_marginTop="6dp" android:layout_marginEnd="6dp"
                android:background="@drawable/vpn_dot" android:visibility="gone"/>
        </FrameLayout>
        <ImageView android:id="@+id/settingsBtn"
                android:layout_width="36dp" android:layout_height="36dp" android:padding="9dp"
                android:src="@drawable/ic_gear" android:background="@drawable/gear_bg" android:tint="@color/gear_tint"
                android:focusable="true" android:focusableInTouchMode="true" android:contentDescription="@string/settings"/>
    </LinearLayout>
    <TextView android:id="@+id/caption" style="@style/Text.Small"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_marginStart="@dimen/overscan_h" android:layout_marginBottom="22dp"
        android:maxLines="1" android:ellipsize="end" android:alpha="0"
        android:shadowColor="@color/text_shadow" android:shadowDy="1" android:shadowRadius="6"/>
    <LinearLayout android:id="@+id/popover"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="78dp" android:layout_marginEnd="@dimen/overscan_h"
        android:orientation="vertical" android:background="@drawable/popover_bg"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="11dp"
        android:visibility="gone" android:alpha="0">
        <TextView android:id="@+id/popNet" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink"/>
        <TextView android:id="@+id/popVpn" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/popRate" style="@style/Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
    </LinearLayout>
</FrameLayout>
