<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:layout_marginStart="@dimen/tile_gap_h" android:layout_marginEnd="@dimen/tile_gap_h"
    android:layout_marginTop="@dimen/tile_gap_v"
    android:clipChildren="false" android:clipToPadding="false">
    <ImageView android:id="@+id/tile"
        android:layout_width="@dimen/tile_w" android:layout_height="@dimen/tile_h"
        android:background="@drawable/tile_bg" android:foreground="@drawable/tile_fg"
        android:focusable="true" android:focusableInTouchMode="true"
        android:importantForAccessibility="no"/>
    <TextView android:id="@+id/label" style="@style/Text.Small"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="@dimen/tile_w"
        android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="@dimen/label_gap" android:alpha="0" android:textColor="@color/ink"
        android:shadowColor="@color/text_shadow" android:shadowDy="2" android:shadowRadius="10"/>
</LinearLayout>
