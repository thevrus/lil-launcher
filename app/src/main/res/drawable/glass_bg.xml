<!-- Glass without a backdrop blur (the Shield runs Android 11): a pale tint, light catching the top half, a bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/glass"/><corners android:radius="@dimen/chip_radius"/></shape></item>
    <item><shape><gradient android:angle="270" android:startColor="@color/glass_sheen" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF"/><corners android:radius="@dimen/chip_radius"/></shape></item>
    <item><shape><stroke android:width="1dp" android:color="@color/glass_rim"/><corners android:radius="@dimen/chip_radius"/></shape></item>
</layer-list>
