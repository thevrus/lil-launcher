<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus lifts the tile (scale and shadow, in code); this is the light on its glass face and rim. -->
    <item android:state_focused="true">
        <layer-list>
            <item><shape><gradient android:angle="300" android:startColor="@color/tile_sheen" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF"/><corners android:radius="@dimen/tile_radius"/></shape></item>
            <item><shape><stroke android:width="1dp" android:color="@color/glass_rim"/><corners android:radius="@dimen/tile_radius"/></shape></item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
